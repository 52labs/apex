{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "apex",
  "type": "registry:style",
  "title": "Apex",
  "description": "Apex design system as a shadcn preset — industrial AI-operations brand. Warm paper, near-black ink, vermilion-orange accent. Hard edges, square chrome, Archivo + JetBrains Mono + Workbench dot-matrix.",
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "color-chart-1": "var(--chart-1)",
      "color-chart-2": "var(--chart-2)",
      "color-chart-3": "var(--chart-3)",
      "color-chart-4": "var(--chart-4)",
      "color-chart-5": "var(--chart-5)",
      "color-apex-paper-0": "#F2F0EB",
      "color-apex-paper": "#E9E7E2",
      "color-apex-paper-1": "#DEDCD6",
      "color-apex-paper-2": "#C9C7C2",
      "color-apex-ink": "#111111",
      "color-apex-ink-2": "#2A2A2A",
      "color-apex-ink-3": "#5C5C5A",
      "color-apex-ink-ghost": "#ABA9A3",
      "color-apex-orange": "#EE5314",
      "color-apex-orange-deep": "#C8420C",
      "color-apex-orange-tint": "#F38256",
      "color-apex-signal-red": "#D42018",
      "color-apex-signal-amber": "#E8A317",
      "color-apex-signal-green": "#2E7D32",
      "color-apex-signal-blue": "#0F4C81",
      "font-sans": "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "font-display": "'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "font-condensed": "'Archivo Narrow', 'Archivo', 'Helvetica Neue Condensed', sans-serif",
      "font-mono": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
      "font-dot": "'Workbench', 'JetBrains Mono', monospace",
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "calc(var(--radius) - 2px)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) + 4px)",
      "radius-apex-input": "2px",
      "radius-apex-chip": "4px",
      "ease-apex-out": "cubic-bezier(0.2, 0.7, 0.1, 1)",
      "ease-apex-in": "cubic-bezier(0.6, 0, 0.8, 0.3)",
      "ease-apex-snap": "cubic-bezier(0.2, 0.9, 0.2, 1.05)"
    },
    "light": {
      "background": "#E9E7E2",
      "foreground": "#111111",
      "card": "#F2F0EB",
      "card-foreground": "#111111",
      "popover": "#F2F0EB",
      "popover-foreground": "#111111",
      "primary": "#EE5314",
      "primary-foreground": "#F2F0EB",
      "secondary": "#DEDCD6",
      "secondary-foreground": "#111111",
      "muted": "#DEDCD6",
      "muted-foreground": "#5C5C5A",
      "accent": "#C8420C",
      "accent-foreground": "#F2F0EB",
      "destructive": "#D42018",
      "destructive-foreground": "#F2F0EB",
      "border": "#111111",
      "input": "#C9C7C2",
      "ring": "#EE5314",
      "chart-1": "#EE5314",
      "chart-2": "#E8A317",
      "chart-3": "#2E7D32",
      "chart-4": "#0F4C81",
      "chart-5": "#D42018",
      "radius": "0rem"
    },
    "dark": {
      "background": "#111111",
      "foreground": "#E9E7E2",
      "card": "#1A1A1A",
      "card-foreground": "#E9E7E2",
      "popover": "#1A1A1A",
      "popover-foreground": "#E9E7E2",
      "primary": "#EE5314",
      "primary-foreground": "#111111",
      "secondary": "#2A2A2A",
      "secondary-foreground": "#E9E7E2",
      "muted": "#2A2A2A",
      "muted-foreground": "#ABA9A3",
      "accent": "#F38256",
      "accent-foreground": "#111111",
      "destructive": "#D42018",
      "destructive-foreground": "#E9E7E2",
      "border": "#2A2A2A",
      "input": "#2A2A2A",
      "ring": "#EE5314",
      "chart-1": "#EE5314",
      "chart-2": "#E8A317",
      "chart-3": "#2E7D32",
      "chart-4": "#0F4C81",
      "chart-5": "#D42018",
      "radius": "0rem"
    }
  },
  "css": {
    "::selection": {
      "background": "#EE5314",
      "color": "#F2F0EB"
    }
  }
}
